msgid "Applies to all game lists. Can be overridden per shortcode with league=\"heading\", league=\"meta\", or league=\"none\"."
msgstr "Gilt für alle Spiellisten. Pro Shortcode übersteuerbar mit league=\"heading\", league=\"meta\" oder league=\"none\"."

msgid "As a heading above the game (large)"
msgstr "Als Überschrift über dem Spiel (groß)"

msgid "Authentication failed. Please check the API key (Volley Manager: Administration -> Club -> Webservice/API)."
msgstr "Authentifizierung fehlgeschlagen. Bitte den API-Key prüfen (Volley Manager: Administration → Club → Webservice/API)."

msgid "Automatically detected when loading the teams (e.g. Volley Pizol)."
msgstr "Wird beim Laden der Teams automatisch erkannt (z. B. Volley Pizol)."

msgid "Automatically loads the club and teams from the Swiss Volley data. Existing aliases, custom team names, league names, and the selection for club-wide views are preserved."
msgstr "Lädt Verein und Mannschaften automatisch aus den Swiss-Volley-Daten. Bestehende Aliase, eigene Teamnamen und Liga-Bezeichnungen sowie die Auswahl für vereinsweite Ansichten bleiben erhalten."

msgid "By league"
msgstr "Nach Liga"

msgid "By team"
msgstr "Nach Team"

